APP_NAME="Toubkal Peaks"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.toubkal-peaks.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel MySQL (prefix is your cPanel username, e.g. cpuser_toubkal)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_toubkal
DB_USERNAME=cpuser_toubkal
DB_PASSWORD=
# Shared with WordPress: keep a prefix that is NOT the WordPress one (wp_)
DB_PREFIX=tp_

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Transactional email through Resend (SMTP). Password = a Resend API key with "sending access".
# The From address must belong to the domain verified in Resend (mail.toubkal-peaks.com).
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@mail.toubkal-peaks.com
MAIL_FROM_NAME="Toubkal Peaks"
# Inbox(es) of the team that get an alert for every new booking request. Several addresses: separate them with commas, e.g. info@toubkal-peaks.com,boss@example.com
BOOKING_NOTIFY_EMAIL=

FRONTEND_URL=https://www.toubkal-peaks.com
REVALIDATE_SECRET=

# Images on Cloudflare R2. R2_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com (no bucket in it)
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=https://cdn.toubkal-peaks.com
# Replies to the customer confirmation email go here (default: reservations@toubkal-peaks.com)
BOOKING_REPLY_TO_EMAIL=reservations@toubkal-peaks.com
