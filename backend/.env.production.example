APP_NAME="Toubkal Peaks"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.toubkal-peaks.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel MySQL (prefix is your cPanel username, e.g. cpuser_toubkal)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_toubkal
DB_USERNAME=cpuser_toubkal
DB_PASSWORD=
# Shared with WordPress: keep a prefix that is NOT the WordPress one (wp_)
DB_PREFIX=tp_

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# cPanel mailbox SMTP
MAIL_MAILER=smtp
MAIL_HOST=mail.toubkal-peaks.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@toubkal-peaks.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@toubkal-peaks.com
MAIL_FROM_NAME="Toubkal Peaks"

FRONTEND_URL=https://www.toubkal-peaks.com
REVALIDATE_SECRET=
